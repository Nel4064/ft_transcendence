  "privacyPolicy": {
    "heading": "隐私政策",
    "intro": "CineClub 是一个面向本地独立电影俱乐部成员的观影排期与社交平台。本页面说明我们收集哪些个人数据、收集原因以及成员对这些数据的控制权。",
    "sections": {
      "collect": {
        "title": "我们收集的信息",
        "body": "账号信息（电子邮箱、显示名称、头像、个人简介）、活动数据（场次报名记录、好友关系、聊天消息），以及（如使用）你的 42 Intra 登录信息或双因素认证密钥。"
      },
      "purpose": {
        "title": "我们为何收集这些信息",
        "body": "用于维护俱乐部的共享观影日程、方便成员互相识别和发送消息、生成个人日历导出文件，以及保障你的账号安全。"
      },
      "thirdParties": {
        "title": "第三方服务",
        "body": "放映时间来自公开的 datacinesindes.fr 数据源。电影翻译通过 The Movie Database (TMDB) 提供。本产品使用 TMDB API，但未获得 TMDB 的认可或认证。我们不会向广告商出售或共享您的数据。"
      },
      "rights": {
        "title": "你的权利",
        "body": "你可以随时在个人资料设置中导出我们保存的所有账号数据副本，或申请永久删除账号。"
      }
    }
  },
  "termsOfService": {
    "heading": "服务条款",
    "intro": "本条款适用于你对 CineClub（一个面向本地独立电影俱乐部成员的观影排期与社交平台）的使用。创建账号即表示你同意遵守以下条款。",
    "sections": {
      "membership": {
        "title": "成员资格",
        "body": "账号仅供俱乐部个人成员使用。你有责任妥善保管登录凭据，并对你账号下的所有活动负责。"
      },
      "acceptableUse": {
        "title": "合理使用规范",
        "body": "请在聊天中保持尊重，如实进行场次报名，不得尝试访问他人账号或滥用观影排期功能。"
      },
      "screeningData": {
        "title": "场次数据说明",
        "body": "放映时间数据来自公开的 datacinesindes.fr 数据源，影院方面可能会在未提前通知的情况下临时调整或出现偏差——出行前请务必再次核对。"
      },
      "termination": {
        "title": "账号终止",
        "body": "你可以随时删除自己的账号。对于违反本条款的账号，我们有权予以停用。"
      }
    }
  },
