# Non-sensitive configuration only. Passwords and keys go in ./secrets/ (see `make secrets`).

# --- General ---
DOMAIN=127.0.0.1

# --- Database ---
POSTGRES_DB=transcendence
POSTGRES_SUPERUSER=change_your_postgres_superuser
POSTGRES_BACKEND_USER=change_your_postgres_backend_user

# --- Backups (see docs/disaster-recovery.md) ---
# seconds between two automatic backups (86400 = one day), and number of DAYS automatic backups are kept
BACKUP_INTERVAL=86400
BACKUP_KEEP=7

# --- 42 OAuth (reserved: enable with auth module) ---
VITE_OAUTH_42_START_URL=/api/auth/oauth/42
FORTYTWO_REDIRECT_URI=http://127.0.0.1:1024/api/auth/oauth/42/callback
FRONTEND_OAUTH_URI=http://127.0.0.1:1024/
