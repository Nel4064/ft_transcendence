// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Language {
  EN
  FR
  ES
}

enum ScreeningVersion {
  VO
  VF
  VOSTF
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  FRIEND_REQUEST     // user sending the request → invited user
  FRIEND_ACCEPTED    // user accepting           → user who asked
  CLUB_PICK          // organizer who picks      → members
  CLUB_PICK_REMOVED  // organizer who unpicks    → members, those who RSVPed
  FRIEND_RSVP        // friend who RSVPs         → their friends
  ROLE_CHANGED       // admin who changes role   → user whose role changed
//  EVENT_CANCELLED    // if event is cancelled (outside CineClub user's scope)    → everyone who RSVPed
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  username         String   @unique @db.VarChar(50)
  displayName      String   @db.VarChar(50)
  email            String   @unique @db.VarChar(255)
  
  // Authentication
  passwordHash     String?  @db.VarChar(255)  // Optional: Only for local registration
  oauth42Id        String?  @unique           // Optional: Only for 42 OAuth login
  
  // Profile Information
  avatarUrl        String?
  bio              String?  @db.Text
  language         Language   @default(EN)    // Default is English
  role             Role     @default(USER)    // Default is regular user
  
  // Two-Factor Authentication (2FA)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?  @db.VarChar(255)
  
  // Audit Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // ----------------------------------------------------
  // 新增：好友相关的反向关联
  // ----------------------------------------------------
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendships            Friendship[]    @relation("UserFriendships")
  friendOf               Friendship[]    @relation("FriendFriendships")

  // Relations
  notificationsRecv  Notification[] @relation("NotificationRecipient")  // received by this user
  notificationsSent  Notification[] @relation("NotificationActor")     // caused by this user

  @@map("users") // Maps the model to a lowercase "users" table in the database
}

model FriendRequest {
  id         String        @id @default(uuid()) @db.Uuid
  senderId   String        @db.Uuid // 发送者 ID
  receiverId String        @db.Uuid // 接收者 ID
  status     RequestStatus @default(PENDING) // 状态：PENDING(待处理), ACCEPTED(已接受), REJECTED(已拒绝)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // 关联到 User 模型
  sender     User          @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId]) // 防止重复向同一个人发送请求
  @@map("friend_requests")
}

model Friendship {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  friendId String   @db.Uuid
  createdAt DateTime @default(now())

  user     User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend   User     @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}


// A screening chosen by the club, copied from the datacinesindes.fr feed if and when picked.
model Screening {
  id               String            @id @default(uuid())
  externalShowId   String            @db.VarChar(20)           // showid (unique per cinema only)
  externalCinemaId Int                                         // cineid

  // Film (snapshot from the feed)
  filmTitle        String                                      // filmtitle, raw
  director         String?                                     // filmdirector
  cast             String?                                     // filmcast
  synopsis         String?                                     // filmstoryline
  genres           String[]          @default([])              // filmgenre, cleaned
  country          String?                                     // filmcountry
  runtimeMinutes   Int?                                        // filmduration, null if implausible
  posterUrl        String?                                     // filmposter, https only
  trailerUrl       String?                                     // filmtrailer, allowed hosts only
  version          ScreeningVersion?                           // filmversion, null if blank
  eventName        String?                                     // evenement
  bookingUrl       String?                                     // showurl (V3)

  // Showtime
  startsAt         DateTime          @db.Timestamptz(3)        // showstart
  endsAt           DateTime          @db.Timestamptz(3)        // showend

  // Cinema
  cinemaName       String            @db.VarChar(60)           // cinenom
  cinemaAddress    String            @db.VarChar(100)          // cineadresse
  cinemaPostalCode String            @db.VarChar(5)            // cinecp
  cinemaCity       String            @db.VarChar(40)           // cineville
  cinemaLatitude   Float?                                      // _coords.lat (V3)
  cinemaLongitude  Float?                                      // _coords.lon (V3)

  // // Club side
  // isCancelled      Boolean           @default(false)
  // rsvps            Rsvp[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([externalCinemaId, externalShowId])
  @@index([startsAt])
  @@map("screenings")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid

  // Recipient: who reads it
  userId          String           @db.Uuid
  user            User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // Actor: who caused it (null if their account was deleted)
  actorId         String?          @db.Uuid
  actor           User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  type            NotificationType
  payload         Json
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
